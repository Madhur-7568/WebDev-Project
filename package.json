{
  "name": "campussync-event-management",
  "version": "1.0.0",
  "description": "Full-stack Campus Event Management & Collaboration Portal for College WebDev Lab",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/src/server.js",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client\"",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test"
  },
  "keywords": [
    "event-management",
    "college-project",
    "mern",
    "react",
    "nodejs",
    "express",
    "rest-api"
  ],
  "author": "CampusSync Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
